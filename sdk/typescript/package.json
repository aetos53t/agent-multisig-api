{
  "name": "@agent-multisig/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Agent Multisig Coordination API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["bitcoin", "multisig", "agent", "ai", "taproot", "psbt"],
  "author": "Aetos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aetos53t/agent-multisig-api"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
